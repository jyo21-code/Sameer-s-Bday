/* hero buttons */
var on=false;
$('#sig').onclick=function(){on=!on;$('#beam').classList.toggle('on',on);$('#moon').classList.toggle('on',on);this.textContent=on?'Gotham is watching':'Light the signal';sfx('sig')};
