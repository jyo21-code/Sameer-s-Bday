setInterval(function(){if(run){fr=(fr+1)%24;sc.value=fr;draw(fr)}},1000/12);draw(0);

/* cake */
var done=false;
for(var i=0;i<5;i++){var b=document.createElement('button');b.className='fl';b.setAttribute('aria-label','candle '+(i+1));b.innerHTML='<i></i><u></u>';
  b.onclick=function(){this.classList.add('out');sfx('puff');if(!done&&document.querySelectorAll('.fl.out').length==5){done=true;boom();$('#wish').textContent='Wish granted, Batman. Ippo poi legendary-a edhavadhu animate pannu!'}};$('#cl').appendChild(b)}

/* easter egg */
