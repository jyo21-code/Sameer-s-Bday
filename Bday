<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday, Batman</title>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0d12;--panel:#151922;--steel:#2a3342;--fog:#9aa7b8;--sig:#f5c518;--ink:#e9edf2;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
*,*:before,*:after{box-sizing:inherit}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 18px/1.55 Barlow,system-ui,sans-serif;overflow-x:hidden}
h1,h2{font-family:"Big Shoulders Display",Impact,sans-serif;margin:0;line-height:.95}
#fx{position:fixed;inset:0;width:100%;height:100%;z-index:0}
#spot{position:fixed;inset:0;z-index:2;pointer-events:none;background:radial-gradient(circle 230px at var(--mx,50%) var(--my,40%),transparent 0,rgba(5,6,9,.3) 70%,rgba(5,6,9,.55) 100%)}
#flash{position:fixed;inset:0;z-index:9;background:#fff;opacity:0;pointer-events:none}
main{position:relative;z-index:1;pointer-events:none}
main button,main input,main .ph,main canvas{pointer-events:auto}
section{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:72px 20px;text-align:center}
#intro{position:fixed;inset:0;z-index:10;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;cursor:pointer;transition:opacity 1s,visibility 1s;padding:20px;text-align:center}
#intro.gone{opacity:0;visibility:hidden}
#intro svg{width:min(60vw,260px);height:auto;fill:var(--sig);filter:drop-shadow(0 0 24px rgba(245,197,24,.6));animation:pulse 2.2s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.07)}}
#intro p{color:var(--fog);margin:0}
.ph{position:relative;width:min(290px,70vw);aspect-ratio:448/506;margin:30px 0 28px;transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .15s;cursor:pointer}
.ph img{width:100%;height:100%;display:block;border-radius:12px;border:2px solid var(--sig);box-shadow:0 0 50px rgba(245,197,24,.3),0 20px 60px #000;object-fit:cover}
.ph svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
#cowl{opacity:0;transform:translateY(-90px);transition:opacity .5s,transform .6s cubic-bezier(.3,1.5,.5,1)}
#cowl.on{opacity:1;transform:none}
h1{font-size:clamp(54px,14vw,150px);font-weight:900;text-shadow:0 0 30px rgba(245,197,24,.25)}
h1 b{color:var(--sig);display:block}
.sub{max-width:36ch;color:var(--fog);margin:14px auto 22px}
.row{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
button{font:600 17px Barlow,sans-serif;color:#111;background:var(--sig);border:0;border-radius:3px;padding:13px 22px;cursor:pointer;transition:transform .15s,box-shadow .15s}
button:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(245,197,24,.4)}
button:focus-visible,input:focus-visible{outline:3px solid #fff;outline-offset:3px}
#beam{position:fixed;left:50%;bottom:-10px;width:0;height:0;z-index:0;pointer-events:none;opacity:0;transition:opacity 1s;border-left:min(24vw,140px) solid transparent;border-right:min(24vw,140px) solid transparent;border-bottom:100vh solid rgba(245,230,150,.2);transform:translateX(-50%);filter:blur(5px)}
#beam.on{opacity:1}
#moon{position:fixed;left:50%;top:6vh;width:min(30vw,140px);aspect-ratio:1;transform:translateX(-50%) scale(.2);opacity:0;z-index:0;border-radius:50%;background:radial-gradient(circle,#fff6c4,var(--sig));display:grid;place-items:center;transition:all 1.1s cubic-bezier(.2,.9,.3,1);pointer-events:none}
#moon svg{width:70%;fill:#0b0d12}
#moon.on{opacity:.9;transform:translateX(-50%) scale(1);box-shadow:0 0 90px 30px rgba(245,197,24,.35)}
#hud{position:fixed;left:14px;top:calc(14px + env(safe-area-inset-top,0px));z-index:5;background:var(--panel);border:1px solid var(--steel);border-radius:3px;padding:9px 14px;color:var(--sig);font-weight:600}
#mute{position:fixed;right:14px;top:calc(14px + env(safe-area-inset-top,0px));z-index:5;padding:9px 14px;background:var(--panel);color:var(--sig);border:1px solid var(--steel)}
#toast{position:fixed;left:50%;bottom:8vh;transform:translate(-50%,30px);z-index:6;background:var(--sig);color:#111;font:900 clamp(22px,5vw,38px) "Big Shoulders Display",Impact,sans-serif;padding:12px 24px;border-radius:3px;opacity:0;transition:all .4s;pointer-events:none;text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
h2{font-size:clamp(40px,8vw,84px);font-weight:900;margin-bottom:8px}
.belt{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;width:min(1050px,100%);margin-top:20px}
.card{perspective:900px;height:250px;background:none;border:0;padding:0;color:var(--ink);box-shadow:none!important}
.card>div{position:relative;width:100%;height:100%;transition:transform .7s;transform-style:preserve-3d}
.card.flip>div{transform:rotateY(180deg)}
.card span{position:absolute;inset:0;backface-visibility:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:20px;border:1px solid var(--steel);border-radius:4px;background:var(--panel)}
.card .bk{transform:rotateY(180deg);border-color:var(--sig);background:#1b1a10;font:400 17px/1.4 Barlow,sans-serif}
.card svg{width:64px;height:36px;fill:var(--sig)}
.card em{font:900 30px "Big Shoulders Display",Impact,sans-serif;font-style:normal}
#cv{width:min(560px,100%);aspect-ratio:7/4;background:var(--panel);border:1px solid var(--steel);border-radius:4px;margin:14px 0 10px}
.ctl{display:flex;gap:14px;align-items:center;width:min(560px,100%)}
input[type=range]{flex:1;accent-color:var(--sig)}
.cake{position:relative;width:min(300px,80vw);margin:40px auto 0}
.cl{display:flex;justify-content:space-around;padding:0 24px;height:70px;align-items:flex-end}
.fl{background:none;border:0;padding:0;width:34px;height:70px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;box-shadow:none!important;transform:none!important}
.fl i{width:12px;height:22px;background:radial-gradient(ellipse at 50% 70%,#fff 0,var(--sig) 45%,#e25822 100%);border-radius:50% 50% 50% 50%/65% 65% 35% 35%;animation:fk .25s infinite alternate;box-shadow:0 0 18px 6px rgba(245,197,24,.5);transition:all .3s}
.fl.out i{transform:scale(0);opacity:0;animation:none}
.fl u{width:7px;height:34px;background:var(--fog)}
@keyframes fk{to{transform:scale(1.1,.92) rotate(3deg)}}
.tier{height:58px;background:var(--steel);border-top:6px solid var(--sig);display:grid;place-items:center}
.tier+.tier{height:70px;width:118%;margin-left:-9%;background:#1e2532}
.tier svg{width:56px;height:32px;fill:var(--sig)}
#wish{min-height:3.2em;margin-top:26px;font:900 clamp(28px,5vw,46px)/1 "Big Shoulders Display",Impact,sans-serif;color:var(--sig);max-width:20ch}
footer{padding:60px 20px 90px;text-align:center;position:relative;z-index:1}
#id{background:var(--panel);color:var(--ink);border:1px solid var(--steel);border-radius:3px;padding:12px 14px;font:600 17px Barlow,sans-serif;width:min(260px,70vw)}
#ans{min-height:2em;color:var(--sig);font-weight:600;margin-top:14px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute"><defs><symbol id="bat" viewBox="0 0 100 56"><path d="M50 4 46 12 38 10C30 6 16 8 2 20c8 0 12 3 14 8 3-3 7-3 11 0 4 4 8 8 12 14l3-6h16l3 6c4-6 8-10 12-14 4-3 8-3 11 0 2-5 6-8 14-8C84 8 70 6 62 10l-8 2z"/></symbol></defs></svg>
<div id="intro" role="button" tabindex="0"><svg viewBox="0 0 100 56"><use href="#bat"/></svg><p>Gotham-la oru birthday! Tap panni ulla vaa. Sound ON pannu.</p></div>
