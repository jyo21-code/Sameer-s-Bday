/* gadgets */
var G=[['The Batarang','Nee veesura ovvoru idea-vum hit aagi, finished film-aa thirumbi varanum, machan!'],['The Grapple','Next rooftop-ku thaavi, nalla studio, nalla job, junior animator, senior animator, creative director, ellam kidaikanum!'],['The Cowl',"Batman persona-va vittudaadha da. Animation world-ku konjam Batman romba thevai!(aprm enaku konjam ;)"],['The Cape','Animation-la follow-through, overlap maari, un life-layum ellam smooth-a flow aagum!, manifesting por you'],['The Batmobile','Treat kudu da! Gotham-la yaarum free-ya vitturavanga illa. Bill unakku thaan!']];
