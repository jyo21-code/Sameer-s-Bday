</section>
</main>

<footer>
  <h2>Last-ah oru vishayam</h2>
  <p class="sub">Yaaru nee? Identify yourself.</p>
  <input id="id" placeholder="Who are you?" autocomplete="off"> <button id="go">Confirm</button>
  <div id="ans" aria-live="polite"></div>
</footer>

<script>
(function(){
var $=function(s){return document.querySelector(s)},cv=$('#fx'),c=cv.getContext('2d'),W,H,mx=innerWidth/2,my=innerHeight*.4,bats=[],conf=[],rang=[],caught=0,won=false;
