  $('#ans').textContent=!v?'':ok?'Obviously. Happy Birthday, Batman. Gotham-ku ippo nimmadhi. 🦇':'Thappu answer. Marubadiyum try pannu, vigilante.';if(ok){boom();zap()}}
$('#go').onclick=chk;$('#id').onkeydown=function(e){if(e.key=='Enter')chk()};

/* music: synthesized beat, bass, pads and brass lead */
var ac,bus,dry,nb,timer,nt=0,step=0,playing=false,ST=.125;
