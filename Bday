  <g id="cowl"><g fill="#0b0d12" stroke="#f5c518" stroke-width="2.5" stroke-linejoin="round"><path d="M150 26 172 -58 220 10Z"/><path d="M270 8 324 -50 328 42Z"/></g><g transform="translate(228 112) rotate(15)"><path mask="url(#mk)" fill="#0b0d12" stroke="#f5c518" stroke-width="2.5" stroke-linejoin="round" d="M-112 -34Q-60 -54 0 -38Q60 -54 112 -28L106 22Q75 38 30 36Q10 26 0 42Q-10 26 -30 36Q-80 40 -108 20Z"/></g></g></svg></div>
  <h1>Happy Birthday<b>Batman.</b></h1>
